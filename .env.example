# ==============================================================================
# Wasla AI — Environment Variables Template
# Copy this file to .env and fill in real values locally. NEVER commit .env.
# ==============================================================================

APP_ENV=development
LOG_LEVEL=INFO
RESTAURANT_TIMEZONE=Africa/Cairo
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8000

# Database (SQLite for local dev, PostgreSQL for staging/production)
# Example PostgreSQL: postgresql+psycopg://wasla:strong_password@postgres:5432/wasla_db
DATABASE_URL=sqlite:///./restaurant_ai.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# AI Model Providers (Active Nov 2026 Models)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PRIMARY_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.8-flash

# Hybrid Audio Pipeline (Option C: Direct Gemini Audio + Groq Whisper Large v3 Turbo)
AI_AUDIO_MODE=hybrid
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=your_openai_api_key_here

# Meta WhatsApp Cloud API (Official Graph API v27.0)
META_VERIFY_TOKEN=restaurant-ai-dev
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_GRAPH_VERSION=v27.0
META_IS_OFFICIAL_BUSINESS_ACCOUNT=false
META_BILLABLE_MESSAGES_AUTHORIZED=false
META_MONTHLY_FREE_SERVICE_LIMIT=1000

# Zero-Cost Cashier Group Notifications (Telegram Bot API)
TELEGRAM_BOT_TOKEN=
CASHIER_TELEGRAM_CHAT_ID=

# Urgent Complaint Escalation (Private Telegram Owner Channel Default + Optional WhatsApp)
RESTAURANT_OWNER_WHATSAPP=
RESTAURANT_OWNER_TELEGRAM_CHAT_ID=
COMPLAINT_ESCALATION_ENABLED=true
OWNER_WHATSAPP_PRIMARY=false

# Sales Assistant, Upsell & Durable External Cron Scheduler
UPSELL_ENABLED=true
REVIEW_DELAY_MINUTES=60
ARRIVAL_CHECK_DELAY_MINUTES=90
SCHEDULER_CRON_SECRET=
SCHEDULER_LEASE_SECONDS=120

# Auth & RBAC (MUST override in production)
AUTH_SECRET_KEY=change-me-in-production-min-32-chars-secret
AUTH_TOKEN_TTL_HOURS=12
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=WaslaAdmin2026!

# Conversation, Security & Rate Limiting
MESSAGE_DEBOUNCE_SECONDS=3.0
SESSION_TTL_SECONDS=3600
REDACT_PII_IN_LOGS=true
MAX_AUDIO_FILE_MB=10
RATE_LIMIT_PER_MINUTE=120
