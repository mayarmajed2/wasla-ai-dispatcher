# ==============================================================================
# Restaurant AI Dispatcher — Environment Variables Template
# Copy this file to .env and fill in real values locally. NEVER commit .env.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
LOG_LEVEL=INFO

# AI Model Provider Keys (obtain from official dashboards)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Only if Whisper / STT pipeline (Option B or C) is approved
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
AI_PRIMARY_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.8-flash
AI_AUDIO_MODE=direct

# Backend Integration Adapter (mock | http)
BACKEND_ADAPTER_MODE=mock
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_KEY=to_be_confirmed_after_backend_inspection

# Conversation & Debounce Configuration
MESSAGE_DEBOUNCE_SECONDS=3.0
SESSION_TTL_SECONDS=3600

# Security & Privacy
REDACT_PII_IN_LOGS=true
MAX_AUDIO_FILE_MB=10
